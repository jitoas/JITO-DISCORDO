# DISCORD_TOKEN: Required to connect the bot to Discord.
# Obtain this from Discord Developer Portal -> Bot -> Reset Token.
DISCORD_TOKEN="YOUR_DISCORD_BOT_TOKEN"

# DISCORD_CLIENT_ID: Your Discord Application ID (Application ID from General Information).
DISCORD_CLIENT_ID="YOUR_DISCORD_APPLICATION_CLIENT_ID"

# DISCORD_GUILD_ID: (Optional) Test Discord Server ID for instant slash command updates.
DISCORD_GUILD_ID="YOUR_TEST_GUILD_ID"

# PORT: Port for the web dashboard / API server (defaults to 3000).
PORT=3000

